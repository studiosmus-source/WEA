<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A2040"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/config_title"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/config_subtitle"
            android:textColor="#90A8C0"
            android:textSize="13sp"
            android:layout_marginBottom="32dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_city"
            android:textColor="#B0C4DE"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/edit_city"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_city"
            android:textColor="#FFFFFF"
            android:textColorHint="#506070"
            android:background="#263050"
            android:padding="12dp"
            android:inputType="text"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_apikey"
            android:textColor="#B0C4DE"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/edit_apikey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_apikey"
            android:textColor="#FFFFFF"
            android:textColorHint="#506070"
            android:background="#263050"
            android:padding="12dp"
            android:inputType="textVisiblePassword"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/apikey_info"
            android:textColor="#607890"
            android:textSize="11sp"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btn_gps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Usa posizione GPS"
            android:textColor="#FFFFFF"
            android:background="#1A4060"
            android:padding="14dp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_save"
            android:textColor="#FFFFFF"
            android:background="#2A5080"
            android:padding="14dp"/>

        <TextView
            android:id="@+id/txt_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#80C0A0"
            android:textSize="12sp"
            android:layout_marginTop="16dp"
            android:gravity="center"/>

        <!-- ── Test effetti ──────────────────────────────────────── -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A3A50"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test effetti meteo"
            android:textColor="#B0C4DE"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btn_t_clear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sereno"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:background="#1A5028"
                android:padding="10dp"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btn_t_cloudy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nuvoloso"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:background="#303848"
                android:padding="10dp"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btn_t_windy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ventoso"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:background="#284058"
                android:padding="10dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_t_rainy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pioggia"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:background="#1A3060"
                android:padding="10dp"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btn_t_stormy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Temporale"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:background="#301828"
                android:padding="10dp"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btn_t_reset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Meteo reale"
                android:textColor="#CCCCCC"
                android:textSize="11sp"
                android:background="#1E2030"
                android:padding="10dp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/txt_test_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#607890"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</ScrollView>
